{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Generated by softonoma-orchestrator project-onboard. allow[]: this project's real safe commands. deny[]: secret files, one env convention per line so .env.example stays readable. enabledPlugins: the core plus the packs matching this stack ({{PACKS}}); add a pack later with /plugin install <pack>@softonoma.",
  "extraKnownMarketplaces": {
    "softonoma": {
      "source": { "source": "github", "repo": "sabi-hawk/softonoma-ai-plugin" }
    }
  },
  "enabledPlugins": {
    "softonoma-orchestrator@softonoma": true{{PACK_LINES}}
  },
  "permissions": {
    "allow": [
      "Bash({{TEST_CMD}})",
      "Bash({{BUILD_CMD}})",
      "Bash({{TYPECHECK_CMD}})"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-secret-writes.mjs" }]
      }
    ]
  }
}
